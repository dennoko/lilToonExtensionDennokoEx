
        //----------------------------------------------------------------------------------------------------------------------
        // Reflection 2nd
        _CustomRefl2ndEnabled ("Enable Reflection 2nd", Float) = 0
        _CustomRefl2ndMaskTex ("Reflection 2nd Mask", 2D) = "white" {}
        _CustomRefl2ndColor ("Reflection 2nd Color", Color) = (1, 1, 1, 1)
        _CustomRefl2ndStrength ("Reflection 2nd Strength", Range(0, 4)) = 1
        _CustomRefl2ndSmoothness ("Reflection 2nd Smoothness", Range(0, 1)) = 0.5
        _CustomRefl2ndLVColorStrength ("Reflection 2nd LV Color Strength", Range(0, 1)) = 1
        _CustomRefl2ndMainColorStrength ("Reflection 2nd Main Color Strength", Range(0, 1)) = 0
        _CustomRefl2ndAnisotropic ("Reflection 2nd Anisotropic Mode", Float) = 0
        _CustomRefl2ndAnisoPrimaryShift ("Reflection 2nd Primary Shift", Range(-1, 1)) = 0
        _CustomRefl2ndAnisoSecondaryColor ("Reflection 2nd Secondary Color", Color) = (1, 1, 1, 1)
        _CustomRefl2ndAnisoSecondaryStrength ("Reflection 2nd Secondary Strength", Range(0, 1)) = 0.5
        _CustomRefl2ndAnisoSecondaryShift ("Reflection 2nd Secondary Shift", Range(-1, 1)) = 0.2
        _CustomRefl2ndShadowAttenuation ("Reflection 2nd Shadow Attenuation", Range(0, 1)) = 0
        _CustomRefl2ndBlur ("Reflection 2nd Blur", Range(0, 1)) = 1

        //----------------------------------------------------------------------------------------------------------------------
        // Rim 2nd
        _CustomRim2ndEnabled ("Enable Rim 2nd", Float) = 0
        _CustomRim2ndColor ("Rim 2nd Color", Color) = (1, 1, 1, 1)
        _CustomRim2ndMaskTex ("Rim 2nd Mask", 2D) = "white" {}
        _CustomRim2ndPower ("Rim 2nd Power", Range(0.1, 8)) = 3
        _CustomRim2ndStrength ("Rim 2nd Strength", Range(0, 1)) = 0.5
        _CustomRim2ndMainColorStrength ("Rim 2nd Main Color Strength", Range(0, 1)) = 0
        _CustomRim2ndBlendMode ("Rim 2nd Blend Mode", Float) = 0
        _CustomRim2ndShadowAttenuation ("Rim 2nd Shadow Attenuation", Range(0, 1)) = 0
        _CustomRim2ndBlur ("Rim 2nd Blur", Range(0, 1)) = 1

        //----------------------------------------------------------------------------------------------------------------------
        // Normal Map 3rd
        [HideInInspector] _CustomNormal3rdUIEnabled ("Enable Normal Map 3rd", Float) = 0
        _CustomNormal3rdEnabled ("Enable Normal Map 3rd", Float) = 0
        _CustomNormal3rdTex ("Normal Map 3rd", 2D) = "bump" {}
        _CustomNormal3rdMaskTex ("Normal Map 3rd Mask", 2D) = "white" {}
        _CustomNormal3rdStrength ("Normal Map 3rd Strength", Range(0, 1)) = 0.5

        //----------------------------------------------------------------------------------------------------------------------
        // Normal Map 1st Ext - Mask
        _CustomBump1stMaskTex  ("Normal 1st Mask", 2D) = "white" {}

        //----------------------------------------------------------------------------------------------------------------------
        // Main Color 2nd/3rd Shadow Suppress
        _CustomMain2ndShadowDisable ("Main Color 2nd Shadow Disable", Range(0, 1)) = 0
        _CustomMain3rdShadowDisable ("Main Color 3rd Shadow Disable", Range(0, 1)) = 0

        //----------------------------------------------------------------------------------------------------------------------
        // Decal
        _CustomDecalEnabled ("Enable Decal", Float) = 0
        [NoScaleOffset] _CustomDecalTex ("Decal Texture", 2D) = "white" {}
        _CustomDecalPosX ("Decal X Position", Range(0, 1)) = 0.5
        _CustomDecalPosY ("Decal Y Position", Range(0, 1)) = 0.5
        _CustomDecalSizeX ("Decal X Size", Float) = 1
        _CustomDecalSizeY ("Decal Y Size", Float) = 1
        _CustomDecalAngle ("Decal Angle", Range(-180, 180)) = 0
        [NoScaleOffset] _CustomDecalMaskTex ("Decal Placement Mask", 2D) = "white" {}
        _CustomDecalColor ("Decal Color", Color) = (1, 1, 1, 1)
        _CustomDecalAlpha ("Decal Alpha", Range(0, 1)) = 1
        _CustomDecalBlendMode ("Decal Blend Mode", Float) = 0
        _CustomDecalShadowDisable ("Decal Shadow Disable", Range(0, 1)) = 0

        //----------------------------------------------------------------------------------------------------------------------
        // Decal Matcap
        _CustomDecalMatcapEnabled ("Enable Decal Matcap", Float) = 0
