Shader "Hidden/dennokoworks/DennokoEx/ltspass_lite_transparent"
{
    HLSLINCLUDE
        //----------------------------------------------------------------------------------------------------------------------
        // Macro

        // Rendering mode
        // 0 : Opaque
        // 1 : Cutout
        // 2 : Transparent
        #define LIL_RENDER 2

        #include "custom.hlsl"
    ENDHLSL

    lilSubShaderInsert "lilCustomShaderInsert.lilblock"
    lilSubShaderBRP "DefaultLiteTwoSide"
    lilSubShaderURP "DefaultLite"
    lilSubShaderHDRP "DefaultLite"

    CustomEditor "Dennokoworks.DennokoExInspector"
}